# BuyerCapBot - copy this file to .env and fill it in. .env is git-ignored.
# Every value below is optional except BOT_TOKEN; the defaults shown are what
# the bot uses when a line is blank or missing.


# --- Telegram ---------------------------------------------------------------

# Token from @BotFather. Required.
BOT_TOKEN=

# Chats the bot POSTS to, comma-separated. Blank = reply in the chat the
# Billing / GRSTK message came from. Use /chatid in a group to get its ID.
REPLY_TO_CHAT_IDS=

# Chats the bot ACCEPTS input from, comma-separated. Blank = any chat it is in.
ALLOWED_CHAT_IDS=

# User IDs allowed to run /setcap and /forget, comma-separated. Blank = anyone.
ADMIN_USER_IDS=

# Username (no @) of the bot that posts the call statistics.
STATS_BOT_USERNAME=GrstkBot

# Answer slash commands (/status, /help, /setcap, ...)? Off by default, because
# these groups host other bots that own /start, /stop and friends - two bots
# replying to one command is worse than none. With this off, EVERY slash message
# is dropped without a reply, /start included; the bot still reads and acts on
# Billing and statistics messages exactly as normal.
ENABLE_COMMANDS=false


# --- Exclusions (buyer codes, comma-separated, case-insensitive) ------------

# Tracked, but never named in a funds reminder.
EXCLUDE_FROM_REMINDERS=

# Tracked, but no cap-update message is posted for them.
EXCLUDE_FROM_UPDATES=

# Ignored entirely - not tracked, not reported.
EXCLUDE_BUYERS=


# --- Reminders --------------------------------------------------------------

# "Cap almost depleted" line: remind at or below this many calls remaining.
ALMOST_DEPLETED_THRESHOLD=10

# Also remind below this % of the buyer's cap. 0 = off.
REMINDER_THRESHOLD_PERCENT=0

# Don't repeat a buyer's reminder within this many minutes unless it got worse.
REMINDER_COOLDOWN_MINUTES=180

# Negative caps always remind, ignoring the cooldown.
ALWAYS_REMIND_NEGATIVE=true

# Master switches for the two unprompted message types.
SEND_UPDATES=true
SEND_REMINDERS=true


# --- Quiet first run --------------------------------------------------------

# On a fresh install, apply messages silently until BOTH a Billing sheet and a
# Buyer statistics report have been taken in - that's the initial configuration.
# The bot then posts one "READY" line and works normally from the next message.
# Commands (/status, /pending, ...) still answer during the quiet run.
# Setting this to false makes the bot post from its very first message.
QUIET_UNTIL_PRIMED=true


# --- Accounting -------------------------------------------------------------

# baseline = charge only calls made since the cap was posted (Billing's figure
#            is already net of calls, which is why it can be negative).
# absolute = remaining is the cap minus every call GRSTK reports.
CAP_ACCOUNTING=baseline

# GRSTK's counter restarts at zero each UTC midnight. When true, caps are
# carried across midnight minus that day's usage.
STATS_RESET_DAILY=true


# --- Double-entry guard -----------------------------------------------------

# Ignore a message identical to one already applied within this many minutes.
DUPLICATE_WINDOW_MINUTES=1440

# Post a notice when a duplicate message or line is skipped.
NOTIFY_ON_DUPLICATE=true

# Messages remembered for the duplicate check. Minimum 50.
PROCESSED_HISTORY_SIZE=500


# --- Storage and runtime ----------------------------------------------------

# Folder for the auto-generated JSON store, created on the first message.
DATA_DIR=data

# IANA zone for day boundaries, daily folders, and timestamps.
TIMEZONE=UTC

# Gap between outgoing messages, in milliseconds.
MESSAGE_DELAY_MS=120

# debug | info | warn | error
LOG_LEVEL=info

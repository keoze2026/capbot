{
  "name": "buyer-cap-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that tracks buyer caps from Billing updates and GRSTK call statistics, posts per-buyer cap updates and low/negative cap reminders.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "simulate": "tsx src/dev/simulate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
